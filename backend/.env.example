# ==============================================================================
# ynabx Backend Environment Configuration (.env)
# ==============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ynabx
SPRING_DATASOURCE_USERNAME=ynabx
SPRING_DATASOURCE_PASSWORD=ynabx_dev_local

# ─── Application Server ───────────────────────────────────────────────────────
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
FLYWAY_ENABLED=true

# ─── Security & JWT ───────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ─── CORS (Allowed Origins) ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
