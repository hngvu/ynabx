<div class="modal-overlay transaction-image-overlay" {{on click this.handleOverlayClick}}>
{{if this.isLoading}}
  <div class="loading-spinner-container">
  <helper_1  />
  </div>
{{else}}
  <div class="image-container" {{on click this.handleOverlayClick}}>
  <img src="this.imageUrl" alt="(helper_2 accounts.transactionImageAltText)">
  </img>
  </div>
{{/if}}
<div class="button-container">
<helper_3 @variant='contrast' />
<hr>
</hr>
<helper_3 @variant='contrast' />
<hr>
</hr>
<helper_3 @variant='contrast' />
</div>
{{if this.showDeleteConfirmation}}
  <helper_5 @confirm='this.removeImage' @cancel='this.closeDeleteConfirmation' />
{{/if}}
</div>