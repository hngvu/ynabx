{
  "name": "ynab-scraper",
  "version": "1.0.0",
  "description": "Playwright-based interactive scraper for YNAB UI components, DOM, SVGs, and styles",
  "type": "module",
  "scripts": {
    "login": "node login.mjs",
    "dump:budget": "node dump-budget.mjs",
    "dump:accounts": "node dump-accounts.mjs",
    "dump:all": "node dump-all.mjs",
